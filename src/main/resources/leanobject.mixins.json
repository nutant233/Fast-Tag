{
  "required": true,
  "minVersion": "0.8",
  "package": "io.github.nutant.leanobject.mixin",
  "plugin": "io.github.nutant.leanobject.Config",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "ingredient.IngredientMixin",
    "ingredient.ItemMixin",
    "ingredient.TagKeyMixin",
    "nbt.CompoundTagMixin",
    "nbt.CompoundTagMixin$Type",
    "nbt.ListTagMixin",
    "nbt.ListTagMixin$Type",
    "resourcelocation.ResourceLocationMixin",
    "resourcelocation.safe.ResourceLocationMixin",
    "resourcekey.ResourceKeyMixin",
    "resourcekey.safe.ResourceKeyMixin",
    "tagkey.TagKeyMixin",
    "tagkey.safe.TagKeyMixin"
  ],
  "injectors": {
    "defaultRequire": 1,
    "maxShiftBy": 5
  },
  "client": []
}
